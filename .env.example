PORT=3001

# Database — set DB_TYPE=sqlite for local dev (no install needed)
#            set DB_TYPE=postgres for production
DB_TYPE=sqlite
DB_PATH=./torn_tracker.db

# PostgreSQL (only needed when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=torn_tracker
DB_USER=torn_user
DB_PASS=changeme

# Admin credentials (plain text here, hashed at startup)
ADMIN_USER=admin
ADMIN_PASS=changeme

# Set to true when Torn API is blocked (routes calls through Google Apps Script proxy)
USE_PROXY=false

# Session
SESSION_SECRET=change-this-to-a-long-random-string
